# ==========================================
# Blog Agent Environment Configuration
# ==========================================

# 1. Google Gemini API Key (Get from: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Target Next.js Repository Settings
# OPTION A: Single JSON variable (convenient for GitHub Actions secrets & clean .env):
TARGET_REPO_CONFIG='{"owner":"your-github-username","name":"your-website-repo","pat":"ghp_your_personal_access_token_here","blogDir":"content/posts","fileExt":"mdx","baseBranch":"main","blogBranch":"blog_branch"}'

# OPTION B: Or configure individually:
# TARGET_REPO_PAT=ghp_your_github_personal_access_token_here
# TARGET_REPO_OWNER=your-github-username
# TARGET_REPO_NAME=your-website-repo
# TARGET_BLOG_DIR=content/posts
# TARGET_FILE_EXT=mdx
# TARGET_BASE_BRANCH=main
# TARGET_BLOG_BRANCH=blog_branch

# 3. Canonical Website URL Settings
# The public domain of your Next.js website (used for generating canonical links)
TARGET_SITE_URL=https://your-domain.com
BLOG_PATH_PREFIX=/blog

# 4. DEV.to Publishing Settings
# Method: 'playwright' (browser automation) or 'api' (REST API)
PUBLISH_METHOD=playwright

# Playwright credentials (for headless automated login)
DEVTO_EMAIL=your_devto_email@example.com
DEVTO_PASSWORD=your_devto_password_here
DEVTO_SESSION_PATH=.auth/devto-session.json
PLAYWRIGHT_HEADLESS=true
DEVTO_PUBLISH_AS_DRAFT=false

# Optional fallback: DEV.to API Key (if PUBLISH_METHOD=api)
DEVTO_API_KEY=your_devto_api_key_here

# 5. Operational Flags
PR_ONLY=false
DRY_RUN=false
